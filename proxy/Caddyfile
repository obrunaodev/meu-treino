{
	# Clientes conectando a um IP podem omitir SNI. Nesse caso, sirva o
	# certificado público do próprio IP em vez de abortar o handshake TLS.
	default_sni {$SERVER_IP}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# API e OAuth. O MinIO nunca é exposto — a API faz o stream da mídia.
	handle /health {
		reverse_proxy api:{$API_PORT}
	}
	handle /api/* {
		reverse_proxy api:{$API_PORT}
	}
	handle /auth/* {
		reverse_proxy api:{$API_PORT}
	}

	# SPA: tudo o mais cai no build estático servido pelo container web.
	handle {
		reverse_proxy web:80
	}
}

# O hostname temporário continua chegando ao app por links já salvos, mas não
# mantém uma segunda origem/cookie: tudo converge para o endereço canônico.
{$LEGACY_SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

# Certificados de IP da Let's Encrypt duram seis dias e exigem explicitamente
# o perfil shortlived. Caddy renova automaticamente; este bloco existe porque
# navegadores modernos tentam HTTPS antes de aceitar um redirect HTTP do IP.
{$SERVER_IP} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}
	redir https://{$SITE_ADDRESS}{uri} permanent
}
