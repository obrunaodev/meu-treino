# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=treino
POSTGRES_PASSWORD=change-me
POSTGRES_DB=treino
DATABASE_URL=postgres://treino:change-me@db:5432/treino

# ── MinIO ────────────────────────────────────────────────────────────────
# Sem rota pública: o browser nunca fala com o MinIO, a API faz o stream.
MINIO_ROOT_USER=treino
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_BUCKET=treino-media
S3_REGION=us-east-1

# ── API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# openssl rand -base64 32
SESSION_SECRET=dev-only-insecure-secret-change-in-prod
# Origem do browser. Em prod: https://seu-dominio
APP_ORIGIN=http://localhost:5173

# ── Google OAuth ─────────────────────────────────────────────────────────
# console.cloud.google.com > Credentials > OAuth client ID > Web application
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Login provisório (enquanto o Google não está configurado) ────────────
# ATENÇÃO: bypass de autenticação. Quem tiver o token entra como qualquer
# usuário. Desligue assim que GOOGLE_CLIENT_ID estiver preenchido.
# A API se recusa a subir com ENABLED=true e token curto.
DEV_LOGIN_ENABLED=false
# A API se RECUSA a subir com NODE_ENV=production e o bypass ligado, a menos
# que esta linha assuma a escolha. Aviso em log vira paisagem; isto não.
# DEV_LOGIN_ALLOW_IN_PRODUCTION=false
# openssl rand -base64 32
DEV_LOGIN_TOKEN=

# ── WhatsApp ─────────────────────────────────────────────────────────────
# Segredo somente entre API e bot; gere outro em produção.
WHATSAPP_INTERNAL_TOKEN=dev-whatsapp-internal-token-change-me-123456

# ── Lembretes por push ───────────────────────────────────────────────────
# Sem as duas chaves o envio fica desligado (e o botão em Configurações não
# tem efeito). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
# Fuso do install, usado para saber o dia da semana e a hora local do aviso.
# O container roda em UTC; sem isto o lembrete sai três horas fora no Brasil.
REMINDER_TIMEZONE=America/Sao_Paulo

# ── Compose ──────────────────────────────────────────────────────────────
# development = hot reload + portas expostas; production = build estático
BUILD_TARGET=development

# URL da API para o bundle do web. O Vite grava isto em tempo de build, então
# mudá-la exige rebuildar a imagem, não só reiniciar o container.
#   dev  → deixe comentado; o padrão é http://localhost:${API_PORT}
#   prod → deixe VAZIO (VITE_API_URL=) para o SPA chamar a mesma origem, que é
#          onde o Caddy publica /api e /auth. Com valor, o navegador de quem
#          visita tentaria falar com a máquina dele.
# VITE_API_URL=
# Portas publicadas no host. Em prod deixe db/minio sem publicar.
DB_PUBLISH=127.0.0.1:5432:5432
MINIO_PUBLISH=127.0.0.1:9000:9000
MINIO_CONSOLE_PUBLISH=127.0.0.1:9001:9001

# ── Caddy (só usado quando houver domínio) ───────────────────────────────
SITE_ADDRESS=:8080
